# Copy to .env for local overrides. Never commit .env.

# Pinned Tracewick package version used by the workload app (must match stand/app/composer.json).
TRACEWICK_VERSION=0.1.0

# Image pins (defaults match compose.yaml).
PHP_VERSION=8.4
EXCIMER_VERSION=1.2.6
NGINX_VERSION=1.28.0
PYROSCOPE_IMAGE=grafana/pyroscope:2.4.2
GRAFANA_IMAGE=grafana/grafana:13.3.0
TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.13.0

# Bind ports (loopback only in compose).
APP_PORT=8080
GRAFANA_PORT=3000
PYROSCOPE_PORT=4040

# 1 = wire profiler; 0 = baseline (profiler object not created).
TRACEWICK_ENABLED=1
# Default for compose / M2 "on". Smoke forces 1.0 for deterministic Pyroscope checks.
TRACEWICK_SAMPLE_RATE=0.1
TRACEWICK_SPOOL_DIR=/var/spool/tracewick
TRACEWICK_SERVICE=benchmarks-workload
TRACEWICK_ENV=bench
WORK_BUSY_MS=25
WORK_SLEEP_MS=10

# Spool soft-admission ceiling (M3 lowers this, e.g. 80).
TRACEWICK_SPOOL_MAX_FILES=500

# M2 fixed-RPS overhead (make bench-overhead)
# RATE=20
# DURATION=2m

# M3 chaos: drain URL override (default http://pyroscope:4040)
# TRACEWICK_PYROSCOPE_URL=http://toxiproxy:14040

